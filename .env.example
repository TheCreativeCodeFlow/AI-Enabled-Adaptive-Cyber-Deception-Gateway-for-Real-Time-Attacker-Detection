# ==============================================================================
# Environment Configuration Template
# Copy this file to .env before starting the services locally:
#   cp .env.example .env
# Never commit real secrets to version control.
# ==============================================================================

# Gateway Service (Stage 2, Stage 3, Stage 5)
GATEWAY_PORT=8080
ORIGIN_URL=http://test-origin:5000
ALLOWED_ORIGINS=http://test-origin:5000,http://localhost:5000,http://127.0.0.1:5000,http://deception:5050,http://localhost:5050,http://127.0.0.1:5050
PROXY_TIMEOUT_MS=5000
MAX_REQUEST_BODY_SIZE=1048576
DETECTION_SERVICE_URL=http://detection:8000
DETECTION_TIMEOUT_MS=500
DETECTION_ENABLED=true

# Adaptive Traffic Routing & Policy Diversion (Stage 5)
# Options: 'shadow' (default, safe observation) or 'active' (policy-controlled diversion)
ROUTING_MODE=shadow
EMERGENCY_DISABLE_DIVERSION=false
DECEPTION_SERVICE_URL=http://deception:5050
DECEPTION_SCORE_THRESHOLD=0.70

# ML Detection Service (Stage 3)
DETECTION_PORT=8000

# Deception Runtime Service (Stage 4)
DECEPTION_PORT=5050
SESSION_TTL_MS=1800000
MAX_SESSIONS=1000

# Backend Service (Stage 1)
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Frontend Service (Stage 1)
FRONTEND_PORT=3000
VITE_BACKEND_URL=http://localhost:4000
VITE_GATEWAY_URL=http://localhost:8080

# Security Hardening & Operator Authentication (Stage 6)
OPERATOR_JWT_SECRET=deception-gateway-operator-secret-key-32chars-min!
JWT_SECRET=deception-gateway-operator-secret-key-32chars-min!
BCRYPT_SALT_ROUNDS=12
# Failure Policy: 'quarantine' (recommended for production, drops attacker on deception failure) or 'fallback_origin'
DECEPTION_FAILURE_POLICY=quarantine

# PostgreSQL Database (Local Infrastructure)
# Note: Host port mapping is removed from docker-compose.yml for network isolation; internal port 5432 is used.
POSTGRES_USER=deception_user
POSTGRES_PASSWORD=deception_pass
POSTGRES_DB=deception_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://deception_user:deception_pass@postgres:5432/deception_db

